{
  "name": "logbull/logbull",
  "description": "PHP client library for LogBull - a simple log collection system",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "logging",
    "logbull",
    "logs",
    "monitoring"
  ],
  "authors": [
    {
      "name": "Rostislav Dugin"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0",
    "monolog/monolog": "^3.0",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "LogBull\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LogBull\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
